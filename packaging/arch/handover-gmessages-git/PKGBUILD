# Maintainer: Handover contributors

pkgname=handover-gmessages-git
pkgver=0.3.1.r0.g0000000
pkgrel=1
pkgdesc='Google Messages helper for Handover (AGPL)'
arch=('x86_64' 'aarch64')
url='https://github.com/mananlalwani/handover-gmessages'
license=('AGPL-3.0-only')
depends=('glibc')
makedepends=('git' 'go')
provides=('handover-gmessages')
conflicts=('handover-gmessages')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd handover-gmessages
  git describe --tags --long 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' \
    || printf '0.0.0.r%s.g%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd handover-gmessages
  export CGO_ENABLED=0
  go build -trimpath -ldflags "-s -w" -o handover-gmessages .
}

package() {
  cd handover-gmessages
  install -Dm755 handover-gmessages "$pkgdir/usr/bin/handover-gmessages"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
